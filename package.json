{
  "name": "ssh-approval-portal",
  "version": "2.3.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2 <25"
  },
  "scripts": {
    "start": "node bridge.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "evaluate:safety": "node scripts/evaluate-safety.mjs",
    "build:ui": "npm --prefix ui ci && npm --prefix ui run build",
    "package": "python3 scripts/package.py",
    "package:client": "python3 scripts/package-client.py",
    "package:release": "python3 scripts/package-release.py",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "6.2.12",
    "ssh-mcp": "file:vendor/ssh-mcp-2.18.0.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
