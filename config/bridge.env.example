# Real secrets are generated into /etc/ssh-mcp-approval-bridge.env, mode 0600.
BRIDGE_MCP_TOKEN=GENERATE_ON_SERVER
BRIDGE_ADMIN_TOKEN=GENERATE_ON_SERVER
BRIDGE_UI_TICKET_KEY=GENERATE_32_BYTE_HEX_ON_SERVER
BRIDGE_ADMIN_ORIGIN=https://ssh-approve.example.com
# Public display labels only (80 characters max); never put secrets here.
# Empty bridge name uses the public admin hostname; empty target name uses SSH.
BRIDGE_DISPLAY_NAME=
BRIDGE_TARGET_DISPLAY_NAME=
# Optional administrator-owned JSON list; each profile pair must pin one distinct SSH host.
# Omit both settings to preserve aws-readonly/aws-local on the legacy default target.
# A configured list without BRIDGE_DEFAULT_TARGET requires an explicit target on new requests.
BRIDGE_TARGETS=
BRIDGE_DEFAULT_TARGET=
BRIDGE_UI_ENABLED=false
BRIDGE_UI_TOOL_PREFIX=ssh-approval-bridge_
BRIDGE_TRANSFER_MAX_BYTES=67108864
BRIDGE_TRANSFER_BUDGET_BYTES=536870912
# 대상별 요청 보관 개수(기본 100, 정수 100~1000). 종료 후 한 시간 보존과 실행 슬롯은 그대로 유지합니다.
# 서비스 재시작 후 적용됩니다. 상향은 필요한 TEST 환경에서만 사용합니다.
BRIDGE_REQUEST_CAPACITY=100
# Agent file inputs stay disabled until an administrator verifies provider hostnames/patterns.
# Comma-separated exact hosts and/or *.domain patterns; wildcard excludes the base domain.
# Example: files.example.test,*.downloads.example.test
# Only a leading *.domain wildcard is supported; no cookies, URLs, paths or query strings.
BRIDGE_UPLOAD_SOURCE_HOSTS=
# Optional browser login via Cloudflare Access; token mode remains the default.
BRIDGE_ADMIN_AUTH_MODE=token
# BRIDGE_ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com
# BRIDGE_ACCESS_AUD=YOUR_APPLICATION_AUD_64_HEX
# BRIDGE_ACCESS_OWNER_EMAILS=owner@example.com
# Optional command-risk observation. Explicitly disclose command/context to TypeSafe.
# BRIDGE_JEV_ENABLED=false
# BRIDGE_JEV_MAX_CALLS=100
# Supply JEV_API_KEY through the existing secret mechanism, never a tracked file.
# Or resolve a reference from a private operator-managed store at service startup.
# BRIDGE_SECRET_STORE_DIR=/var/lib/ssh-mcp/.local/share/ssh-mcp/secrets
# BRIDGE_JEV_KEY_REF=secret://local-file/model-safety-api-key
# Optional read-only Vault KV v2; use the local hidden-input CLI for the reader token.
# The KV record must have one value field. TLS uses Node's configured CA trust.
# BRIDGE_VAULT_URL=https://vault.example.test
# BRIDGE_VAULT_MOUNT=secret
# BRIDGE_VAULT_TOKEN_REF=secret://local-file/vault-reader-token
# BRIDGE_JEV_KEY_REF=secret://vault/model-safety-api-key
