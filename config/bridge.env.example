BRIDGE_ADMIN_ORIGIN=https://ssh-approve.example.com
BRIDGE_UI_ENABLED=false
BRIDGE_UI_TOOL_PREFIX=ssh-approval-bridge_
BRIDGE_TRANSFER_MAX_BYTES=67108864
BRIDGE_TRANSFER_BUDGET_BYTES=536870912
