[Unit]
Description=SSH Approval Portal
After=network.target ssh.service

[Service]
Type=simple
User=mcpbridge
Group=mcpbridge
WorkingDirectory=/var/lib/ssh-mcp/app
EnvironmentFile=/etc/ssh-mcp-approval-bridge.env
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/ssh-approval-launcher
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
