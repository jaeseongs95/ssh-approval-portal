{
  "ssh-completion-inbox": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/portal-files.mjs --host antigravity --event SessionStart",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/portal-files.mjs --host antigravity --event PreInvocation",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node ./scripts/portal-files.mjs --host antigravity --event PostToolUse",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/portal-files.mjs --host antigravity --event PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/portal-files.mjs --host antigravity --event Stop",
        "timeout": 10
      }
    ]
  }
}
