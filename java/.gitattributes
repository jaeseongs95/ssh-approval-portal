# Line endings are fixed per file kind so that a checkout on Windows or Linux runs the same files:
# shell scripts and the Unix Gradle wrapper script must stay LF (a CR breaks the shebang line), Windows command files must stay CRLF.
* text=auto eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.jar binary
# The risk catalogue and the automation question are copied byte for byte from 2.x and a test pins their SHA-256: no line-ending conversion on any checkout.
portal-domain/src/main/resources/risk/*.json -text
