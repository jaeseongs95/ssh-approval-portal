{
  "name": "artifact-begin",
  "description": "Reserve a byte upload bound to operationKey, target revision, destination, size and SHA-256. Use when authorized bytes are already available. For PC files, run packaged portal-files upload --file PATH outside the model and use its UUID with files. This tool cannot read PC paths and starts no SSH work; retain the transfer id.",
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "operationKey": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{16,128}(?![\\s\\S])" },
      "target": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
      "expectedTargetRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
      "size": { "type": "integer", "minimum": 0, "maximum": 67108864 },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "remotePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "overwrite": { "default": false, "type": "boolean" },
      "elevate": { "default": false, "type": "boolean" }
    },
    "required": ["operationKey", "target", "expectedTargetRevision", "fileName", "size", "sha256", "remotePath"],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["contractVersion", "ok", "data", "error"],
    "properties": {
      "contractVersion": { "const": "2.0" },
      "ok": { "type": "boolean" },
      "data": { "anyOf": [{ "$ref": "#/$defs/beginData" }, { "type": "null" }] },
      "error": { "anyOf": [{ "$ref": "#/$defs/errorData" }, { "type": "null" }] }
    },
    "$defs": {
      "identifier": { "type": "string", "pattern": "^[a-f0-9]{48}$" },
      "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "target": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
      "nint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "errorData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "retryable", "executionAttempted"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,95}$" },
          "retryable": { "type": "boolean" },
          "executionAttempted": { "anyOf": [{ "type": "boolean" }, { "const": "unknown" }] }
        }
      },
      "beginData": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "received", "sequence", "size", "sha256", "expiresAt", "targetId", "targetRevision", "maxChunkBytes"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "received": { "$ref": "#/$defs/nint" },
          "sequence": { "$ref": "#/$defs/nint" },
          "size": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "sha256": { "$ref": "#/$defs/digest" },
          "expiresAt": { "$ref": "#/$defs/nint" },
          "targetId": { "$ref": "#/$defs/target" },
          "targetRevision": { "$ref": "#/$defs/digest" },
          "maxChunkBytes": { "const": 262144 }
        }
      }
    }
  },
  "annotations": { "readOnlyHint": false, "destructiveHint": true, "idempotentHint": false },
  "portalRules": {
    "outputSchema": "public-contract.mjs:74-75 responseSchema(): .refine(value => value.ok ? value.data !== null && value.error === null : value.data === null && value.error !== null, 'Expected data or error'). Not expressed in the outputSchema (a Zod .refine is absent from the SDK-published JSON Schema); recorded here only."
  },
  "visibility": "public"
}
