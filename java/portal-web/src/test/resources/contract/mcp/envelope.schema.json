{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ssh-approval-portal:contract:2.0:envelope",
  "title": "Contract 2.0 response envelope",
  "description": "Response envelope of the public (model-visible, non-UI) MCP tools. Source: src/adapters/mcp/public-contract.mjs:73-75 (errorData, responseSchema), :145-148 (publicReply), :162-168 (publicError). The per-tool `data` shape is in each contract/mcp/tools/<name>.json outputSchema; here `data` is only constrained to object-or-null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "ok", "data", "error"],
  "properties": {
    "contractVersion": { "const": "2.0" },
    "ok": { "type": "boolean" },
    "data": { "type": ["object", "null"] },
    "error": { "anyOf": [{ "$ref": "#/$defs/errorData" }, { "type": "null" }] }
  },
  "if": { "required": ["ok"], "properties": { "ok": { "const": true } } },
  "then": { "properties": { "data": { "type": "object" }, "error": { "type": "null" } } },
  "else": { "properties": { "data": { "type": "null" }, "error": { "type": "object" } } },
  "x-portal-rule": "public-contract.mjs:74-75 .refine(value => value.ok ? value.data !== null && value.error === null : value.data === null && value.error !== null, 'Expected data or error'). Expressed with if/then/else.",
  "$defs": {
    "errorData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "executionAttempted"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,95}$" },
        "retryable": { "type": "boolean" },
        "executionAttempted": { "anyOf": [{ "type": "boolean" }, { "const": "unknown" }] }
      }
    }
  },
  "x-portal-wire": {
    "success": "{ content: [{ type: 'text', text: JSON.stringify(envelope) }], structuredContent: envelope } (public-contract.mjs:145-148); desktop-observe appends content[1] = { type: 'image', mimeType: 'image/png', data } (public-contract.mjs:180, 289-294)",
    "failure": "{ isError: true, content: [{ type: 'text', text: JSON.stringify(envelope) }], structuredContent: envelope } with ok=false, data=null (public-contract.mjs:167)",
    "errorCodeRule": "public-contract.mjs:164 code = error.code when it matches /^[A-Z][A-Z0-9_]{1,95}$/, else the value mapped from error.message in transferRefusals (public-contract.mjs:149-161), else 'REQUEST_REFUSED'.",
    "retryableRule": "public-contract.mjs:165 retryable = error.retryable === true || code === 'ARTIFACT_MAINTENANCE'",
    "executionAttemptedRule": "public-contract.mjs:166 typeof error.executionAttempted === 'boolean' ? that value : (error.accepted === false || the message was found in transferRefusals) ? false : 'unknown'; failure() helper (public-contract.mjs:102) always sets executionAttempted=false",
    "notCoveredByEnvelope": "show-* and ui-* tools (server.mjs) do not use this envelope; their failures return content text 'Request refused or failed. Check authentication, state, limits and permissions.' (or the context/source/read refusal JSON/text in results.mjs:105-130) with isError: true. See contract/mcp/tools/show-*.json, ui-*.json and docs/migration/contract-baseline.md."
  },
  "x-portal-errorCodes": {
    "regex": "^[A-Z][A-Z0-9_]{1,95}$",
    "regexSource": "src/adapters/mcp/public-contract.mjs:73",
